div class=\"img-item\">\n                    <img src=\"@PROJECT_PATH@/assets/images/portugal-wedding-videographer-guests-958x539.jpg\" alt=\"A peaceful beach with turquoise waters, capturing the beauty of coastal landscapes.\" title=\"Nature Documentary Production – Showcasing the Serenity of Coastal Ecosystems.\">\n                    <div class=\"img-caption\" mbr-if=\"showCaption\">\n                        <p class=\"mbr-fonts-style align-center mbr-black\" mbr-theme-style=\"display-7\">\n                            Mobile friendly\n                        </p>\n                    </div>\n                </div>\n            </div>\n    </div>\n</section>",
